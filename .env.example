PORT=3000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/thingstodo
PUBLIC_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
TRUST_PROXY=0
# Optional: supply a private admin password of at least 14 characters.
# When blank, first startup generates private credentials in .secrets/initial-admin.json.
ADMIN_EMAIL=info@oldalexhub.com
ADMIN_PASSWORD=
# Free OpenStreetMap imports and recurring sync are enabled by default.
OSM_ENABLED=true
SYNC_ENABLED=true
EVENTS_ENABLED=true
HASHTAG_TRACKING_ENABLED=true
UPLOAD_DIR=uploads
LOG_RETENTION_DAYS=30
AUTO_SEED=true
AUTO_CREATE_ADMIN=true
