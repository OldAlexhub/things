PORT=3000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/thingstodo
PUBLIC_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
TRUST_PROXY=0
# Bootstrap only. Set a unique password of at least 14 characters, run npm run seed,
# then remove ADMIN_PASSWORD from the environment. Never commit credentials.
ADMIN_EMAIL=info@oldalexhub.com
ADMIN_PASSWORD=
TICKETMASTER_API_KEY=
# Providers remain disabled until an administrator records permission and enables them.
OSM_ENABLED=false
TICKETMASTER_ENABLED=false
SYNC_ENABLED=false
UPLOAD_DIR=uploads
LOG_RETENTION_DAYS=30
