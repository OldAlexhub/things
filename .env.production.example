PORT=3000
NODE_ENV=production
MONGODB_URI=
PUBLIC_URL=https://things.server.oldalexhub.com
CORS_ORIGINS=https://things.server.oldalexhub.com
# Set to the exact number of trusted reverse-proxy hops for your deployment.
TRUST_PROXY=0
ADMIN_EMAIL=info@oldalexhub.com
# Bootstrap only. Supply privately, run npm run seed, then remove.
ADMIN_PASSWORD=
TICKETMASTER_API_KEY=
OSM_ENABLED=false
TICKETMASTER_ENABLED=false
SYNC_ENABLED=false
# Point to durable writable storage on the host.
UPLOAD_DIR=uploads
LOG_RETENTION_DAYS=30
