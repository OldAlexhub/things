PORT=3000
NODE_ENV=production
MONGODB_URI=mongodb://127.0.0.1:27017/thingstodo
PUBLIC_URL=https://things.server.oldalexhub.com
CORS_ORIGINS=https://things.server.oldalexhub.com
# Set to the exact number of trusted reverse-proxy hops for your deployment.
TRUST_PROXY=0
ADMIN_EMAIL=info@oldalexhub.com
# Optional bootstrap password. Blank creates private credentials on first startup.
ADMIN_PASSWORD=
OSM_ENABLED=true
SYNC_ENABLED=true
EVENTS_ENABLED=true
HASHTAG_TRACKING_ENABLED=true
# Point to durable writable storage on the host.
UPLOAD_DIR=uploads
LOG_RETENTION_DAYS=30
AUTO_SEED=true
AUTO_CREATE_ADMIN=true
